    <string name="onboarding_step">%1$d / %2$d</string>
    <string name="onboarding_intro_title">Control your bed from your phone</string>
    <string name="onboarding_intro_body">Adjust head and feet height, save and recall favorite positions (presets), and set a morning wake-up position with Samsung Modes and Routines. First, connect your bed.</string>
    <string name="onboarding_start">Get started</string>
    <string name="onboarding_permission_denied">Without permission, the app cannot connect to the bed. Allow ‘Permissions → Nearby devices’ in the app settings.</string>
    <string name="onboarding_connect_title">Connect bed</string>
    <string name="onboarding_connect_body">Turn on the bed and keep your phone close to it. Tap ‘Find bed’ and choose your bed from the list.</string>
    <string name="onboarding_find_bed">Find bed</string>
    <string name="pairing_not_found">Don’t see your bed in the list?</string>
    <string name="pairing_not_found_desc">Some beds can only be found by name. Turn this on, then tap ‘Find bed’ again.</string>

