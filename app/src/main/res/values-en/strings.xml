    <string name="about_title">About</string>
    <string name="about_version">Version %1$s</string>
    <string name="about_unofficial">Not an official app of LINAK® or HANSAEM. This is an independent app compatible with electric beds that use a LINAK controller.</string>
    <string name="about_developer">Developer</string>
    <string name="about_privacy">Privacy</string>
    <string name="about_privacy_body">This app creates no account and sends no data off your device. It does not read other apps’ notifications. Troubleshooting logs are stored only on your device and are shared only when you export them yourself. Donation payments are handled by Google Play, and the app never receives card or other payment details.</string>
    <string name="about_privacy_policy">View privacy policy</string>
    <string name="about_licenses">Open-source licenses</string>
    <string name="about_licenses_body">This app uses Android Jetpack (AndroidX, Compose, Room, DataStore, Navigation), Kotlin · kotlinx.coroutines, and Dagger · Hilt. All are licensed under the Apache License 2.0.</string>
    <string name="about_licenses_apache">View the full Apache License 2.0</string>
    <string name="about_donation_title">Buy the developer a coffee</string>
    <string name="about_donation_body">If you like the app, you can support the developer with the price of a coffee. Payment goes through Google Play. Donations are optional and do not affect app features.</string>
    <string name="about_donation_button">Buy a coffee · %1$s</string>
    <string name="about_donation_thanks">Thank you for your support!</string>
    <string name="about_donation_pending">Your donation will be completed once the payment is confirmed.</string>
    <string name="about_donation_failed">The payment could not be completed. Please try again later.</string>
    <string name="about_no_app">No app is available to open it</string>

