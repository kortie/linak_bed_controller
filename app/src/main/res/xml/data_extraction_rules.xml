<?xml version="1.0" encoding="utf-8"?>
<!-- 페어링(CDM 연결)·설정·로그는 이 기기·이 침대에 묶인 데이터이므로 클라우드 백업과 기기 간 이전에서 모두 제외한다. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
